---
import '../styles/global.css';
const {title='Independent technology reporting',description='Independent reporting on technology, security, gaming and the open web.',type='website'}=Astro.props;
const full=title==='Independent technology reporting'?'IbrahimBlog — Independent technology reporting':`${title} — IbrahimBlog`;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{full}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={full}/><meta property="og:description" content={description}/><meta property="og:type" content={type}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social.svg',Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="alternate" type="application/rss+xml" title="IbrahimBlog RSS" href="/rss.xml"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><a class="skip" href="#main">Skip to content</a><header class="mast"><div class="mast-top wrap"><a class="brand" href="/" aria-label="IbrahimBlog home"><span class="mark">i<span>.</span></span><span>IBRAHIM<span class="brand-light">BLOG</span><small>TECHNOLOGY, IN CONTEXT</small></span></a><div class="mast-meta">Independent publication <span>●</span> India &amp; beyond</div><a class="search-link" href="/search/" aria-label="Search articles">⌕ <span>Search</span></a></div><nav class="wrap nav" aria-label="Main navigation"><a href="/category/ai/">AI &amp; Technology</a><a href="/category/cyber/">Cybersecurity</a><a href="/category/gaming/">Gaming &amp; Hardware</a><a href="/category/dev/">Developer &amp; Open Source</a><a href="/archive/">Archive</a></nav></header><main id="main"><slot/></main><footer><div class="wrap footer-grid"><div><a class="footer-brand" href="/">ibrahim<span>.</span>blog</a><p>Clear reporting for a complicated digital world.</p></div><div><strong>THE PUBLICATION</strong><a href="/about/">About</a><a href="/editorial-policy/">Editorial policy</a><a href="/corrections/">Corrections</a></div><div><strong>GET IN TOUCH</strong><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/rss.xml">RSS feed ↗</a></div></div><div class="wrap footer-bottom">© {new Date().getFullYear()} IbrahimBlog <span>Made for curious minds.</span></div></footer></body></html>
