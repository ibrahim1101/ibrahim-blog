---
import Base from '../layouts/Base.astro'; import {allArticles,categories,fmt} from '../lib'; const articles=await allArticles();
---
<Base title="Search"><div class="wrap listing"><div class="eyebrow">The journal / Find a story</div><h1>Search</h1><label for="search">Search titles, summaries, and subjects</label><input id="search" class="search-input" type="search" placeholder="Try cybersecurity or open source" autocomplete="off"/><p class="hint" id="count" aria-live="polite">{articles.length} stories available</p><div id="results" class="grid">{articles.map(a=><article class="card" data-search={`${a.data.title} ${a.data.description} ${categories[a.data.category]}`.toLowerCase()}><div class="meta">{categories[a.data.category]} / {fmt(a.data.published)}</div><h3><a href={`/articles/${a.id}/`}>{a.data.title}</a></h3><p>{a.data.description}</p></article>)}</div></div><script>const input=document.querySelector<HTMLInputElement>('#search'); const cards=[...document.querySelectorAll<HTMLElement>('[data-search]')]; const count=document.querySelector('#count'); input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let n=0;cards.forEach(c=>{const show=(c.dataset.search||'').includes(q);c.hidden=!show;if(show)n++});if(count)count.textContent=`${n} ${n===1?'story':'stories'} found`;});</script></Base>
