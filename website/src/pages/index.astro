---
import Base from '../layouts/Base.astro';
import { allArticles, categories, fmt } from '../lib';
const articles=await allArticles(); const featured=articles[0];
---
<Base><section class="wrap hero"><div><div class="eyebrow">Independent technology journalism &nbsp; / &nbsp; Est. 2026</div><h1>The story<br/>behind the <em>signal.</em></h1></div><div><p class="hero-copy">Technology moves fast. We take a closer look at the developments that matter, with evidence, context, and a little less noise.</p><div class="hero-note"><span>Curiosity, with clarity</span><span>↓ Explore the journal</span></div></div></section><section class="wrap section"><div class="section-title"><h2>In focus</h2><span class="eyebrow">The latest / 01</span></div>{featured ? <a class="feature" href={`/articles/${featured.id}/`}><div class="feature-art"><span>i.</span></div><div class="feature-body"><span class="eyebrow">{categories[featured.data.category]} &nbsp; — &nbsp; {fmt(featured.data.published)}</span><h3>{featured.data.title}</h3><p>{featured.data.description}</p><strong>Read the story ↗</strong></div></a> : <div class="feature"><div class="feature-art"><span>i.</span></div><div class="feature-body"><span class="eyebrow">Our first edition is in the works</span><h3>Good stories deserve a closer look.</h3><p>We’re preparing our first articles. Each story will be reviewed, sourced, and published with care.</p><a class="text-link" href="/editorial-policy/"><strong>Our editorial standards ↗</strong></a></div></div>}</section><section class="wrap section"><div class="section-title"><h2>Latest stories</h2><a href="/archive/">View the archive ↗</a></div>{articles.length ? <div class="grid">{articles.slice(0,6).map(a=><article class="card"><div class="meta"><span class="tag">{categories[a.data.category]}</span> / {fmt(a.data.published)}</div><h3><a href={`/articles/${a.id}/`}>{a.data.title}</a></h3><p>{a.data.description}</p><a class="text-link" href={`/articles/${a.id}/`}>Read story ↗</a></article>)}</div>:<p class="empty">No articles have been published yet. Check back soon for our first edition.</p>}</section><section class="wrap section"><div class="section-title"><h2>Explore by subject</h2><span class="eyebrow">Find your perspective</span></div><div class="category-grid">{Object.entries(categories).map(([id,name],i)=><a href={`/category/${id}/`}><span>0{i+1} / TOPIC</span><strong>{name}</strong><span>Explore ↗</span></a>)}</div></section></Base>
