---
import Base from '../layouts/Base.astro';
const siteKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title="Contact"><div class="wrap"><article class="prose"><div class="eyebrow">Tips, questions &amp; corrections</div><h1>Let’s talk.</h1><p>Have a story tip, a question, or a correction? Send a note and include any relevant links.</p>{siteKey ? <form id="contact-form"><label for="name">Name</label><input id="name" name="name" maxlength="100" required/><label for="email">Email</label><input id="email" name="email" type="email" maxlength="254" required/><label for="message">Message</label><textarea id="message" name="message" maxlength="5000" minlength="10" required></textarea><div class="hp" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div><div class="cf-turnstile" data-sitekey={siteKey}></div><button type="submit">Send message ↗</button><p id="contact-result" role="status" aria-live="polite"></p></form>:<p class="empty">The contact form is being configured. In the meantime, email <a href="mailto:contact@ibrahimshaik.com">contact@ibrahimshaik.com</a>.</p>}<p class="hint">Please don’t send passwords or sensitive personal information. See our <a href="/privacy/">privacy policy</a>.</p></article></div>{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}<script>const form=document.querySelector<HTMLFormElement>('#contact-form');form?.addEventListener('submit',async (e)=>{e.preventDefault();const result=document.querySelector('#contact-result');const button=form.querySelector<HTMLButtonElement>('button');if(button)button.disabled=true;if(result)result.textContent='Sending…';try{const res=await fetch('/api/contact',{method:'POST',body:new FormData(form)});if(!res.ok)throw new Error('Unable to send');form.reset();if(result)result.textContent='Message sent. Thank you.';}catch{if(result)result.textContent='Could not send your message. Please email contact@ibrahimshaik.com.';}finally{if(button)button.disabled=false;}});</script></Base>
